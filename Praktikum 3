        <!-- MULTIMEDIA -->
        <section id="media">

            <h2>Multimedia</h2>


            <!-- AUDIO -->
            <article>

                <h3>Audio</h3>

                <p>
                    Contoh elemen audio:
                </p>

                <audio controls>

                    <source
                        src="audio.mp3"
                        type="audio/mpeg"
                    >

                    Browser Anda tidak mendukung
                    elemen audio.

                </audio>

            </article>


            <!-- VIDEO -->
            <article>

                <h3>Video</h3>

                <p>
                    Contoh elemen video:
                </p>

                <video
                    controls
                    width="500"
                >

                    <source
                        src="video.mp4"
                        type="video/mp4"
                    >

                    Browser Anda tidak mendukung
                    elemen video.

                </video>

            </article>

        </section>


