        <!-- FORM KONTAK -->
        <section id="kontak">

            <h2>Form Kontak Mahasiswa</h2>

            <form action="#" method="post">

                <!-- NAMA -->
                <p>
                    <label for="nama">
                        Nama:
                    </label>
                    <br>

                    <input
                        type="text"
                        id="nama"
                        name="nama"
                        minlength="3"
                        maxlength="30"
                        required
                    >
                </p>


                <!-- EMAIL -->
                <p>
                    <label for="email">
                        Email:
                    </label>
                    <br>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                    >
                </p>


                <!-- PASSWORD -->
                <p>
                    <label for="password">
                        Password:
                    </label>
                    <br>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        minlength="6"
                        required
                    >
                </p>


                <!-- UMUR -->
                <p>
                    <label for="umur">
                        Umur:
                    </label>
                    <br>

                    <input
                        type="number"
                        id="umur"
                        name="umur"
                        min="17"
                        max="100"
                        required
                    >
                </p>


                <!-- TANGGAL LAHIR -->
                <p>
                    <label for="tanggal">
                        Tanggal Lahir:
                    </label>
                    <br>

                    <input
                        type="date"
                        id="tanggal"
                        name="tanggal"
                        required
                    >
                </p>


                <!-- RADIO BUTTON -->
                <fieldset>

                    <legend>
                        Jenis Kelamin
                    </legend>

                    <input
                        type="radio"
                        id="laki"
                        name="jenis_kelamin"
                        value="Laki-laki"
                        required
                    >

                    <label for="laki">
                        Laki-laki
                    </label>


                    <input
                        type="radio"
                        id="perempuan"
                        name="jenis_kelamin"
                        value="Perempuan"
                    >

                    <label for="perempuan">
                        Perempuan
                    </label>

                </fieldset>


                <!-- CHECKBOX -->
                <p>

                    <label>
                        Hobi:
                    </label>

                    <br>

                    <input
                        type="checkbox"
                        id="coding"
                        name="hobi"
                        value="Coding"
                    >

                    <label for="coding">
                        Coding
                    </label>


                    <input
                        type="checkbox"
                        id="musik"
                        name="hobi"
                        value="Musik"
                    >

                    <label for="musik">
                        Musik
                    </label>


                    <input
                        type="checkbox"
                        id="olahraga"
                        name="hobi"
                        value="Olahraga"
                    >

                    <label for="olahraga">
                        Olahraga
                    </label>

                </p>


                <!-- SELECT -->
                <p>

                    <label for="prodi">
                        Program Studi:
                    </label>

                    <br>

                    <select
                        id="prodi"
                        name="prodi"
                        required
                    >

                        <option value="">
                            -- Pilih Prodi --
                        </option>

                        <option value="informatika">
                            Teknik Informatika
                        </option>

                        <option value="sistem-informasi">
                            Sistem Informasi
                        </option>

                        <option value="Teknik-Industri">
                            Teknik Industri
                        </option>

                        <option value="Manajemen-Akutansi">
                            Manajemen Akutansi
                        </option>

                    </select>

                </p>


                <!-- TEXTAREA -->
                <p>

                    <label for="pesan">
                        Pesan:
                    </label>

                    <br>

                    <textarea
                        id="pesan"
                        name="pesan"
                        rows="5"
                        cols="40"
                        minlength="10"
                        maxlength="1000"
                        required
                    ></textarea>

                </p>


                <!-- BUTTON -->
                <button type="submit">
                    Kirim
                </button>

                <button type="reset">
                    Reset
                </button>

            </form>

